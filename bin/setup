#!/usr/bin/env bash
# bin/setup — one-time setup for HookView local development.
#
# Idempotent: safe to run repeatedly. Gets you from a fresh clone to a ready
# state — Docker daemon (Colima) up, deps installed, env file in place, and the
# Redis + SRH backing services running.
set -euo pipefail

cd "$(dirname "$0")/.."

# ── dedicated Colima instance ────────────────────────────────────────────────
# Run in our own "webhook" profile so we never start or touch the default
# Colima. DOCKER_CONTEXT pins docker/compose to this instance for the duration
# of the script without changing your globally-active context.
COLIMA_PROFILE="webhook"
export DOCKER_CONTEXT="colima-${COLIMA_PROFILE}"

# ── pretty output ────────────────────────────────────────────────────────────
bold() { printf "\033[1m%s\033[0m\n" "$1"; }
info() { printf "\033[34m▸\033[0m %s\n" "$1"; }
ok()   { printf "\033[32m✓\033[0m %s\n" "$1"; }
warn() { printf "\033[33m!\033[0m %s\n" "$1"; }
die()  { printf "\033[31m✗ %s\033[0m\n" "$1" >&2; exit 1; }

bold "HookView setup"

# ── prerequisites ────────────────────────────────────────────────────────────
command -v docker >/dev/null 2>&1 || die "Docker not found. Install Docker CLI (e.g. 'brew install docker')."
command -v colima >/dev/null 2>&1 || die "Colima not found. Install it with 'brew install colima'."
command -v npm    >/dev/null 2>&1 || die "npm not found. Install Node.js (e.g. via mise or 'brew install node')."
ok "Prerequisites present (docker, colima, npm)"

# ── Colima (Docker daemon) ───────────────────────────────────────────────────
if colima status -p "$COLIMA_PROFILE" >/dev/null 2>&1; then
  ok "Colima profile '$COLIMA_PROFILE' already running"
else
  info "Starting Colima profile '$COLIMA_PROFILE'…"
  colima start -p "$COLIMA_PROFILE"
  ok "Colima profile '$COLIMA_PROFILE' started"
fi

# ── env file ─────────────────────────────────────────────────────────────────
if [ -f .env.local ]; then
  ok ".env.local already exists"
else
  cp .env.example .env.local
  ok "Created .env.local from .env.example (points at the local SRH proxy)"
fi

# ── dependencies ─────────────────────────────────────────────────────────────
info "Installing npm dependencies…"
npm install
ok "Dependencies installed"

# ── backing services (Redis + SRH) ───────────────────────────────────────────
info "Starting Redis + SRH containers…"
docker compose up -d redis srh

info "Waiting for the SRH proxy to accept connections…"
TOKEN="$(grep -E '^UPSTASH_REDIS_REST_TOKEN=' .env.local | cut -d= -f2-)"
for i in $(seq 1 30); do
  if curl -fsS -X POST http://localhost:8079 \
       -H "Authorization: Bearer ${TOKEN}" \
       -H "Content-Type: application/json" \
       -d '["PING"]' 2>/dev/null | grep -q PONG; then
    ok "SRH proxy is up (Redis reachable on localhost:8079)"
    break
  fi
  [ "$i" -eq 30 ] && die "SRH did not become ready. Check 'docker compose logs srh'."
  sleep 1
done

echo
bold "Setup complete 🎉"
echo "Next:  bin/dev        # start the dev server (tears containers down on exit)"
echo "       PORT=3939 bin/dev   # if port 3000 is taken by another app"
